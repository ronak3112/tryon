<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Try on the 23.06 ct Emerald Cut | Anita Diamonds</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500&display=swap" rel="stylesheet">
<style>
:root{--bg:#fbf6ec;--ink:#3a2a1a;--gold:#b8862f;--line:#e3d3ac}
*{box-sizing:border-box}
html,body{height:100%;margin:0}
body{background:var(--bg);color:var(--ink);font-family:"Cormorant Garamond",Georgia,serif;font-size:18px;display:flex;flex-direction:column}
header{padding:14px 16px 8px;text-align:center;border-bottom:1px solid var(--line)}
header h1{margin:0;font-weight:500;font-size:22px;color:var(--gold);letter-spacing:.04em}
header p{margin:2px 0 0;font-size:15px}
#stage{position:relative;flex:1;min-height:0;background:#1b1510}
canvas{width:100%;height:100%;object-fit:contain;display:block}
#msg{position:absolute;left:12px;right:12px;bottom:12px;padding:10px 14px;background:rgba(251,246,236,.94);border:1px solid var(--line);text-align:center;font-size:16px}
#start{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;background:var(--bg);padding:24px;text-align:center}
#start p{max-width:30ch;margin:0}
button,select{font:inherit;color:var(--ink);background:var(--bg);border:1px solid var(--gold);padding:8px 14px;border-radius:2px}
button.primary{background:var(--gold);color:#fff;font-size:20px;padding:12px 26px}
button:focus-visible,select:focus-visible,input:focus-visible{outline:2px solid var(--ink);outline-offset:2px}
.controls{display:flex;flex-wrap:wrap;gap:10px;align-items:center;justify-content:center;padding:10px 12px calc(10px + env(safe-area-inset-bottom,0px));border-top:1px solid var(--line)}
.controls label{display:flex;gap:8px;align-items:center;font-size:16px}
.hidden{display:none!important}
</style>
</head>
<body>
<header>
  <h1>23.06 ct Emerald Cut</h1>
  <p>I colour, VS2 clarity. GIA 2235795412. 20.30 x 13.61 x 8.76 mm</p>
</header>

<div id="stage">
  <canvas id="c"></canvas>
  <div id="msg" class="hidden"></div>
  <div id="start">
    <p>See this diamond on your own hand, at its true size.</p>
    <p>Hold your hand up with the back of the hand facing the camera.</p>
    <button class="primary" id="go">Start camera</button>
    <p id="err" style="color:#9b2c2c"></p>
  </div>
</div>

<div class="controls">
  <label>Finger
    <select id="finger">
      <option value="13,14">Ring</option>
      <option value="9,10">Middle</option>
      <option value="5,6">Index</option>
      <option value="17,18">Little</option>
    </select>
  </label>
  <label>Hand size
    <input id="size" type="range" min="60" max="85" value="70">
  </label>
  <button id="flip">Switch camera</button>
</div>

<video id="v" playsinline muted class="hidden"></video>

<script type="module">
import { FilesetResolver, HandLandmarker } from "https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@0.10.14/vision_bundle.mjs";

// ---- Stone data (change these for each stone) ----
const STONE = { lengthMM: 20.30, widthMM: 13.61 };

const $ = id => document.getElementById(id);
const video = $("v"), canvas = $("c"), ctx = canvas.getContext("2d");
let landmarker, facing = "user", lastTime = -1;
const sm = { x: 0, y: 0, a: 0, s: 0, ok: false }; // smoothed pose

function say(t){ const m=$("msg"); if(t){m.textContent=t;m.classList.remove("hidden")}else m.classList.add("hidden"); }

async function startCamera(){
  if (video.srcObject) video.srcObject.getTracks().forEach(t => t.stop());
  const stream = await navigator.mediaDevices.getUserMedia({
    video: { facingMode: facing, width: { ideal: 1280 }, height: { ideal: 720 } }, audio: false });
  video.srcObject = stream;
  await video.play();
  canvas.width = video.videoWidth; canvas.height = video.videoHeight;
}

async function init(){
  $("err").textContent = "";
  try {
    $("go").disabled = true; $("go").textContent = "Loading...";
    const fileset = await FilesetResolver.forVisionTasks("https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@0.10.14/wasm");
    landmarker = await HandLandmarker.createFromOptions(fileset, {
      baseOptions: { modelAssetPath: "https://storage.googleapis.com/mediapipe-models/hand_landmarker/hand_landmarker/float16/1/hand_landmarker.task", delegate: "GPU" },
      runningMode: "VIDEO", numHands: 1 });
    await startCamera();
    $("start").classList.add("hidden");
    say("Show the back of your hand to the camera.");
    requestAnimationFrame(loop);
  } catch (e) {
    $("go").disabled = false; $("go").textContent = "Start camera";
    $("err").textContent = "Camera could not start. Allow camera access in your browser settings and try again.";
    console.error(e);
  }
}

const d = (a,b) => Math.hypot(a.x-b.x, a.y-b.y);
const lerp = (a,b,t) => a+(b-a)*t;

function loop(){
  requestAnimationFrame(loop);
  if (video.readyState < 2) return;
  const W = canvas.width, H = canvas.height, mirror = facing === "user";
  ctx.save();
  if (mirror){ ctx.translate(W,0); ctx.scale(-1,1); }
  ctx.drawImage(video, 0, 0, W, H);

  if (video.currentTime !== lastTime){
    lastTime = video.currentTime;
    const res = landmarker.detectForVideo(video, performance.now());
    const h = res.landmarks && res.landmarks[0];
    if (h){
      const [i,j] = $("finger").value.split(",").map(Number);
      const A = {x:h[i].x*W, y:h[i].y*H}, B = {x:h[j].x*W, y:h[j].y*H};
      const knuckle = d({x:h[5].x*W,y:h[5].y*H}, {x:h[17].x*W,y:h[17].y*H});
      const pxPerMM = knuckle / Number($("size").value);
      // ring sits on the section of finger between the knuckle and the first joint
      const t = 0.42;
      const tx = lerp(A.x,B.x,t), ty = lerp(A.y,B.y,t);
      const ang = Math.atan2(B.y-A.y, B.x-A.x) - Math.PI/2; // stone long axis along the finger
      const k = sm.ok ? 0.35 : 1;
      sm.x = lerp(sm.x,tx,k); sm.y = lerp(sm.y,ty,k); sm.s = lerp(sm.s,pxPerMM,k);
      let da = ang - sm.a; da = Math.atan2(Math.sin(da), Math.cos(da));
      sm.a += da*k; sm.ok = true; sm.miss = 0;
      say("");
    } else if (++sm.miss > 8){ sm.ok = false; say("Show the back of your hand to the camera."); }
  }
  if (sm.ok) drawRing(sm.x, sm.y, sm.a, sm.s);
  ctx.restore();
}

// Emerald cut outline: rectangle with clipped corners, inset by f of width
function oct(w, h, cut, inset){
  const x = w/2 - inset, y = h/2 - inset*(h/w), c = Math.max(cut - inset*0.6, 1);
  return [[-x+c,-y],[x-c,-y],[x,-y+c],[x,y-c],[x-c,y],[-x+c,y],[-x,y-c],[-x,-y+c]];
}
function poly(p){ ctx.beginPath(); p.forEach((q,n)=> n?ctx.lineTo(q[0],q[1]):ctx.moveTo(q[0],q[1])); ctx.closePath(); }

function drawRing(x, y, a, s){
  const w = STONE.widthMM*s, h = STONE.lengthMM*s, cut = w*0.2;
  const fingerW = 18*s, tt = performance.now()/1000;
  ctx.save(); ctx.translate(x,y); ctx.rotate(a);

  // gold band wrapping the finger
  ctx.fillStyle = "rgba(0,0,0,.25)"; ctx.fillRect(-fingerW/2-1, -1.5*s+2, fingerW+2, 3.4*s);
  const g = ctx.createLinearGradient(0,-2*s,0,2*s);
  g.addColorStop(0,"#f3dc9a"); g.addColorStop(.5,"#c89a3c"); g.addColorStop(1,"#8f6a22");
  ctx.fillStyle = g; ctx.fillRect(-fingerW/2, -1.5*s, fingerW, 3*s);

  // soft shadow of the stone on the skin
  ctx.shadowColor = "rgba(0,0,0,.35)"; ctx.shadowBlur = 10*s; ctx.shadowOffsetY = 2*s;
  const outer = oct(w,h,cut,0);
  poly(outer); ctx.fillStyle = "#dfe6ec"; ctx.fill();
  ctx.shadowColor = "transparent";

  // step-cut layers: crown steps toward the table
  const insets = [0, w*0.09, w*0.18, w*0.27];
  const shades = ["#c9d3dc","#f4f7fa","#aebbc7","#eef3f7"];
  for (let n=0; n<3; n++){
    const A = oct(w,h,cut,insets[n]), B = oct(w,h,cut,insets[n+1]);
    for (let e=0; e<8; e++){
      const e2 = (e+1)%8;
      ctx.beginPath(); ctx.moveTo(...A[e]); ctx.lineTo(...A[e2]); ctx.lineTo(...B[e2]); ctx.lineTo(...B[e]); ctx.closePath();
      const flash = 0.5 + 0.5*Math.sin(tt*1.6 + e*1.3 + n);
      ctx.fillStyle = shades[(e+n)%4];
      ctx.globalAlpha = 0.88; ctx.fill();
      ctx.fillStyle = `rgba(255,255,255,${0.35*flash})`; ctx.fill();
      ctx.globalAlpha = 1;
    }
  }
  // table
  const T = oct(w,h,cut,insets[3]); poly(T);
  const tg = ctx.createLinearGradient(-w/2,-h/2,w/2,h/2);
  tg.addColorStop(0,"rgba(255,255,255,.95)"); tg.addColorStop(.5,"rgba(214,226,236,.85)"); tg.addColorStop(1,"rgba(255,255,255,.9)");
  ctx.fillStyle = tg; ctx.fill();

  // facet edges
  ctx.strokeStyle = "rgba(90,110,130,.55)"; ctx.lineWidth = Math.max(s*0.12,.6);
  insets.forEach(i => { poly(oct(w,h,cut,i)); ctx.stroke(); });
  const O = oct(w,h,cut,0), I = oct(w,h,cut,insets[3]);
  ctx.beginPath(); O.forEach((p,n)=>{ ctx.moveTo(...p); ctx.lineTo(...I[n]); }); ctx.stroke();

  // moving sparkle
  const sx = Math.sin(tt*1.1)*w*0.25, sy = Math.cos(tt*0.8)*h*0.3, r = w*0.07;
  const sp = ctx.createRadialGradient(sx,sy,0,sx,sy,r*3);
  sp.addColorStop(0,"rgba(255,255,255,.95)"); sp.addColorStop(1,"rgba(255,255,255,0)");
  ctx.fillStyle = sp; ctx.fillRect(sx-r*3, sy-r*3, r*6, r*6);
  ctx.restore();
}

$("go").addEventListener("click", init);
$("flip").addEventListener("click", async () => {
  facing = facing === "user" ? "environment" : "user";
  try { await startCamera(); } catch(e){ console.error(e); }
});
</script>
</body>
</html>
